{
    "app-id": "com.github.tenderowl.norka",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "norka",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--env=LD_LIBRARY_PATH=/app/lib"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/gtk-doc",
        "/share/vala",
        "/testing",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name": "granite",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/elementary/granite/archive/6.2.0.tar.gz",
                    "sha256": "067d31445da9808a802fca523630c3e4b84d2d7c78ae547ced017cb7f3b9c6b5"
                }
            ]
        },
        {
            "name" : "gtksourceview",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/gtksourceview/4.8/gtksourceview-4.8.4.tar.xz",
                    "sha256" : "7ec9d18fb283d1f84a3a3eff3b7a72b09a10c9c006597b3fbabbb5958420a87d"
                }
            ]
        },
        {
            "name" : "gspell",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/gspell/1.11/gspell-1.11.1.tar.xz",
                    "sha256": "ef6aa4e3f711775158a7e241a5f809cf2426bc0e02c23a7d2b5c71fc3de00292"
                }
            ]
        },
        "python3-lxml.json",
        "python3-markdown2.json",
        "python3-requests.json",
        "python3-htmldocx.json",
        {
            "name": "norka",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/TenderOwl/Norka/archive/1.1.0.tar.gz",
                    "sha256": "b9b0098eb42a82db8e1e696006412056e64d0ae826d0c97c328aeb05e65202dc"
                }
            ]
        }
    ]
}
